# Copy this file to `.env` and adjust as needed for your environment.
# All values here are read by app/core/config.py (pydantic-settings).

APP_NAME="Money Transfer System"
APP_ENV=local
DEBUG=false

HOST=0.0.0.0
PORT=8000

# Async driver (asyncpg) -- used by the running application.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/money_transfer
# Sync driver (psycopg2) -- used only by Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/money_transfer
# Dedicated database for the test suite. The name MUST end in `_test`
# (tests/conftest.py refuses to run against anything else).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/money_transfer_test

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

DEFAULT_CURRENCY=USD
MAX_TRANSACTION_HISTORY_PAGE_SIZE=100
DEFAULT_TRANSACTION_HISTORY_PAGE_SIZE=20

LOG_LEVEL=INFO
LOG_JSON=true

IDEMPOTENCY_KEY_TTL_HOURS=24
